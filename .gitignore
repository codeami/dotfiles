# herdr runtime artifacts (regenerated at runtime; never commit)
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/*.sock
home/.config/herdr/.plugins.lock

# macOS + nix build noise
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# full raw video transcripts (condensed captures live in inbox/)
second-brain/raw/

# oh-my-claudecode project memory and session logs
.omc/

# context: session notes and drift output can hold private details; this repo is public
context/inbox/sessions/*
!context/inbox/sessions/.gitkeep
context/inbox/drift/

# blog: generated board and publish exports
context/areas/blog/drafts/index.html
context/areas/blog/drafts/export/

# local scratch and env fixtures never go public
scratch/
.env.staging
